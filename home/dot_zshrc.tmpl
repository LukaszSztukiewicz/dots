# --- powerlevel10k instant prompt (must stay near the top) ---
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- PATH ---
# Prepend ~/.local/bin so user-installed binaries (chezmoi, bw, dua, fd shim,
# etc.) win over distro defaults. Done early so fzf/OMZ see them.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # theme handled by powerlevel10k below
plugins=(git fzf zsh-autosuggestions zsh-syntax-highlighting you-should-use zsh-bat zsh-vi-mode)
[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# --- powerlevel10k theme ---
P10K_THEME="$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme"
[ -s "$P10K_THEME" ] && source "$P10K_THEME"
[ -f ~/.p10k.zsh ] && source ~/.p10k.zsh

# --- core shell options ---
setopt AUTO_CD
setopt HIST_IGNORE_DUPS
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# --- default editor ---
# Honored by git fallback, crontab, less !command, gpg, etc.
# sudoedit additionally needs `Defaults env_editor` (or an explicit
# `Defaults editor=/usr/bin/vim`) in /etc/sudoers to pick this up.
export EDITOR=vim
export VISUAL=vim
export GIT_EDITOR=vim

# --- fzf ---
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
# Prefer `fd`; fall back to Ubuntu's `fdfind` when the shim isn't in PATH.
# Skip entirely if neither is present — bare fzf still works.
if (( $+commands[fd] )); then
    _fd_bin=fd
elif (( $+commands[fdfind] )); then
    _fd_bin=fdfind
fi
if [ -n "${_fd_bin:-}" ]; then
    export FZF_DEFAULT_COMMAND="$_fd_bin --type f --hidden --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="$_fd_bin --type d --hidden --exclude .git"
fi
unset _fd_bin
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}'"
# Note: --style minimal needs fzf >= 0.57 (newer than Ubuntu LTS apt).
# Re-enable if you've upgraded fzf:
#   export FZF_DEFAULT_OPTS="--style minimal"

# --- chezmoi / dots helpers ---
# cap: BW-aware chezmoi apply wrapper
cap() {
    "$(chezmoi source-path)/../scripts/apply.sh" "$@"
}

# cdots: jump to dotfiles repo root
alias cdots='cd "$(chezmoi source-path)/.."'

{{ if .proxy -}}
# --- proxy ---
export http_proxy={{ .proxy | quote }}
export https_proxy={{ .proxy | quote }}
export no_proxy=localhost,127.0.0.1
{{ end -}}

# --- language version managers ---
# Each block is a single existence check, so missing managers cost ~nothing.
# Install on demand with the matching scripts/install-<name>.sh.

# uv (creates ~/.local/bin/env on install)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# juliaup
[ -d "$HOME/.juliaup/bin" ] && export PATH="$HOME/.juliaup/bin:$PATH"

# conda (miniconda installed under ~/miniconda3)
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# sdkman MUST stay last per upstream guidance.
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"
