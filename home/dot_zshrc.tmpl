# --- powerlevel10k instant prompt (must stay near the top) ---
# Mode is set inside ~/.p10k.zsh (see POWERLEVEL9K_INSTANT_PROMPT=quiet).
# The cache file below is generated by p10k on the first prompt render, so
# the loader is a no-op on a brand-new machine — that's expected.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- PATH ---
# Prepend ~/.local/bin so user-installed binaries (chezmoi, bw, dua, fd shim,
# etc.) win over distro defaults. Done early so fzf/OMZ see them.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # theme handled by powerlevel10k below
# fzf integration comes via ~/.fzf.zsh (installed by scripts/install-fzf.sh)
# rather than the OMZ fzf plugin, which errors out when the Debian/Ubuntu
# fzf package doesn't ship /usr/share/doc/fzf/examples/.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting you-should-use)
[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# Emacs-mode keybindings (default for OMZ, made explicit here so nothing
# else flips us into vi-mode). Must come BEFORE the compinit + bindkey
# block below: `bindkey -e` switches the main keymap to emacs and would
# otherwise stomp any ^I binding set against a different active keymap.
bindkey -e

# Belt-and-braces completion init. OMZ normally calls compinit, but if it
# fails to load (no .oh-my-zsh dir on a fresh apply, plugin order, plugin
# clobbers the binding, …) TAB silently becomes self-insert — typing a
# literal tab character instead of completing. Force-init AFTER bindkey -e
# and bind explicitly into the emacs keymap so plugins loaded after this
# point can't quietly remove the binding from main.
autoload -Uz compinit
compinit -i
zmodload -i zsh/complist
bindkey -M emacs '^I' expand-or-complete
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'

# Ctrl-X Ctrl-E opens the current command line in $EDITOR — useful for
# editing long pipelines. Zsh ships the widget but doesn't bind it by
# default; this matches bash's behavior.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# --- powerlevel10k theme ---
P10K_THEME="$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme"
[ -s "$P10K_THEME" ] && source "$P10K_THEME"
[ -f ~/.p10k.zsh ] && source ~/.p10k.zsh

# --- core shell options ---
setopt AUTO_CD
setopt HIST_IGNORE_DUPS
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# --- default editor ---
# Honored by git fallback, crontab, less !command, gpg, etc.
# sudoedit additionally needs `Defaults env_editor` (or an explicit
# `Defaults editor=/usr/bin/vim`) in /etc/sudoers to pick this up.
export EDITOR=vim
export VISUAL=vim
export GIT_EDITOR=vim

# --- fzf ---
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
# Prefer `fd`; fall back to Ubuntu's `fdfind` when the shim isn't in PATH.
# Skip entirely if neither is present — bare fzf still works.
if (( $+commands[fd] )); then
    _fd_bin=fd
elif (( $+commands[fdfind] )); then
    _fd_bin=fdfind
fi
if [ -n "${_fd_bin:-}" ]; then
    export FZF_DEFAULT_COMMAND="$_fd_bin --type f --hidden --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="$_fd_bin --type d --hidden --exclude .git"
fi
unset _fd_bin
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}'"
# Note: --style minimal needs fzf >= 0.57 (newer than Ubuntu LTS apt).
# Re-enable if you've upgraded fzf:
#   export FZF_DEFAULT_OPTS="--style minimal"

# --- chezmoi / dots helpers ---
# cap: BW-aware chezmoi apply wrapper.
# Hardcoded path avoids invoking `chezmoi source-path` (which acquires the
# chezmoi state lock and can block if another chezmoi instance is running).
DOTS_REPO_ROOT="$HOME/.local/share/chezmoi"
cap() {
    "$DOTS_REPO_ROOT/scripts/apply.sh" "$@"
}

# cdots: jump to dotfiles repo root
alias cdots='cd "$DOTS_REPO_ROOT"'

{{ if .proxy -}}
# --- proxy ---
export http_proxy={{ .proxy | quote }}
export https_proxy={{ .proxy | quote }}
export no_proxy=localhost,127.0.0.1
{{ end -}}

# --- language version managers ---
# Each block is a single existence check, so missing managers cost ~nothing.
# Install on demand with the matching scripts/install-<name>.sh.

# uv (creates ~/.local/bin/env on install)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# juliaup
[ -d "$HOME/.juliaup/bin" ] && export PATH="$HOME/.juliaup/bin:$PATH"

# conda (miniconda installed under ~/miniconda3)
if [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniconda3/etc/profile.d/conda.sh"
fi

# sdkman MUST stay last per upstream guidance.
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"
