{{- /*
  tmux config split by machineRole.
    laptop      → minimal: Ctrl-Space prefix, mouse, wheel-passthrough, history, escape-time.
    everything else → full workstation config (default Ctrl-b prefix, splits, status bar).
*/ -}}
# -- nested-tmux clipboard (OSC52 passthrough) --
# Lets selection inside a remote tmux land on the *local* clipboard via the
# host terminal emulator. Requires tmux >= 3.3 on both ends. allow-passthrough
# is what lets the remote tmux's OSC52 escape sequence travel through the
# local tmux to the terminal. set-clipboard on + terminal-features ':clipboard'
# tells tmux to emit OSC52 on copy.
set -g set-clipboard on
set -g allow-passthrough on
set -as terminal-features ',*:clipboard'
bind -T copy-mode    MouseDragEnd1Pane send-keys -X copy-pipe-no-clear
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-no-clear

{{- if eq .machineRole "laptop" }}
# -- laptop tmux config --
#
# Note: changes here only affect *new* tmux sessions. To pick up edits in a
# running server: `prefix r` (reloads in place), or `tmux kill-server` for a
# clean reset.
unbind C-b
set -g prefix C-Space
bind C-Space send-prefix
set -g mouse on
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e; send-keys -M'"
set-option -g history-limit 50000
set-option -sg escape-time 10
# reload config in place
bind r source-file ~/.config/tmux/tmux.conf \; display "Config reloaded"

# -- laptop status bar (cyan accent to match p10k role-accent override) --
set -g status-style bg=colour235,fg=colour39
set -g status-left "#[fg=colour39]#S "
set -g status-right "#[fg=colour39]%Y-%m-%d %H:%M"
{{- else }}
# -- workstation tmux config (default Ctrl-b prefix) --

# -- general --
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"
set-option -g history-limit 50000
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set-option -sg escape-time 10

# Wheel scrolls into copy-mode on first scroll, then sends scroll events through.
bind -n WheelUpPane if-shell -F -t = "#{mouse_any_flag}" "send-keys -M" "if -Ft= '#{pane_in_mode}' 'send-keys -M' 'copy-mode -e; send-keys -M'"

# -- splits --
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# -- reload config --
bind r source-file ~/.config/tmux/tmux.conf \; display "Config reloaded"

# -- status bar --
set -g status-style bg=colour235,fg=colour136
set -g status-left "#[fg=colour166]#S "
set -g status-right "#[fg=colour136]%Y-%m-%d %H:%M"
{{- end }}
