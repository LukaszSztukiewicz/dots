#!/usr/bin/env bash
set -euo pipefail

# Auto-install btop on chezmoi apply. Skipped on server-role machines.
#
# Why {{ .chezmoi.sourceDir }} instead of $(chezmoi source-path):
# the latter spawns a *second* chezmoi process while the parent is
# still holding the persistent state lock, deadlocks waiting for it,
# and ultimately returns an empty string. We resolve the path at
# template-render time so the rendered script holds a literal path.
#
# install-btop.sh hash: {{ include "../scripts/install-btop.sh" | sha256sum }}

machine_role="{{ .machineRole }}"
if [ "$machine_role" = "server" ]; then
    echo "[dots] Skipping btop install on server role."
    exit 0
fi

exec "{{ .chezmoi.sourceDir }}/../scripts/install-btop.sh"
