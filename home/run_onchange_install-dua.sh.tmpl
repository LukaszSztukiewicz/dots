#!/usr/bin/env bash
set -euo pipefail

# Auto-install dua-cli on chezmoi apply. Skipped on server-role machines.
# See run_onchange_install-btop.sh.tmpl for why we use {{ .chezmoi.sourceDir }}
# instead of `$(chezmoi source-path)` (nested chezmoi deadlocks on the state lock).
#
# install-dua.sh hash: {{ include "../scripts/install-dua.sh" | sha256sum }}

# shellcheck source=/dev/null
. "{{ .chezmoi.sourceDir }}/../scripts/lib/colors.sh"

exec "{{ .chezmoi.sourceDir }}/../scripts/install-dua.sh"
